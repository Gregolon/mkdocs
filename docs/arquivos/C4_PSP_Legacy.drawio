<mxCell id="p2_site" value="&lt;b style=&quot;font-size:16px&quot;&gt;Site Estático (Front-end)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: HTML5, CSS3, JavaScript]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Páginas psp.html (home: destaque, vídeo, jogos essenciais, história e guia de hardware) e newsletter.html (formulário). Executa no navegador.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;strokeWidth=2.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p2_api" value="&lt;b style=&quot;font-size:16px&quot;&gt;API de Newsletter&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: Vercel Serverless Function, Node.js] · a confirmar&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Valida e registra a inscrição (nome, e-mail, modelo de PSP favorito) e aciona o envio de e-mail.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#1A1A1A;fontColor=#FFFFFF;strokeWidth=2.5;align=center;dashed=1;dashPattern=9 6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="610" width="320" height="160" as="geometry"/></mxCell>
