<mxCell id="p2_vc" value="&lt;b style=&quot;font-size:16px&quot;&gt;Vercel&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Sistema Externo]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Hospedagem e CDN. Serve o site estático e executa a função serverless.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#4A4A4A;fontColor=#FFFFFF;strokeWidth=2.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="330" width="260" height="150" as="geometry"/></mxCell>
